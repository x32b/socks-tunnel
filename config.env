# ===== Remote (relay) server - SSH connection used for the tunnel =====
# Server IP or hostname
REMOTE_HOST=CHANGE_ME
# Server SSH port
REMOTE_PORT=22
# User with sudo on the server (needs a key OR password to log in)
REMOTE_USER=CHANGE_ME

# ===== Tunnel =====
# Dedicated user created on the server for tunnelling only
TUNNEL_USER=tunnel
# Local SOCKS proxy address and port
LOCAL_SOCKS_ADDR=127.0.0.1
LOCAL_SOCKS_PORT=1080
# Host block name in ~/.ssh/config
SSHCONFIG_HOST=tunnel
# Local tunnel key
LOCAL_KEY=~/.ssh/tunnel

# ===== Proxy bypass =====
# Comma-separated domains that must NOT go through the tunnel.
# Keep the LLM provider API here so model traffic stays direct (local IP),
# while web search / fetch still use the tunnel.
# Add your provider if different, e.g. api.anthropic.com,api.openai.com
PROXY_BYPASS=opencode.ai,models.opencode.ai

# ===== DNS / SOCKS scheme =====
# socks5h = resolve DNS on the remote server (no DNS leak from the local
#           network; needed where local DNS is filtered/poisoned).
# socks5  = resolve DNS locally, send IPs through the tunnel.
# Note: tools that do not understand the "socks5h" scheme will fall back
#       to resolving locally regardless - set PROXY_SOCKS5H=0 for those.
PROXY_SOCKS5H=1

# ===== HTTP bridge (fallback for tools that don't speak SOCKS) =====
# Some runtimes, e.g. the one bundled with OpenCode (Bun), honour proxy
# environment variables but only with an http:// URL and may ignore
# socks5//socks5h:// scheme. Set PROXY_BRIDGE=1 to run bridge.py: a tiny
# HTTP CONNECT => SOCKS5 forwarder on 127.0.0.1:BRIDGE_PORT, and export
# plain http:// proxy URLs instead of socks ones.
PROXY_BRIDGE=1
# Local port for the HTTP bridge (used only when PROXY_BRIDGE=1).
# The bridge listener ALWAYS binds 127.0.0.1 regardless of LOCAL_SOCKS_ADDR.
BRIDGE_PORT=18080

# ===== Remote source allow-list (used by setup-remote.sh on the server) =====
# Comma-separated CIDR/IP list of THIS machine's public addresses (e.g. the
# prefixes announced by your ISP's ASN) the tunnel key may be used from.
# Applied on the server as  restrict,port-forwarding,from="<list>" <key>
# plus a  Match User <tunnel> Address <list>  sshd drop-in.
# Empty = no source restriction (key works from anywhere).
#
# Example (a home ISP announces a /22, a /24 and a /23):
#   REMOTE_ALLOW_FROM=1.2.3.0/22,1.2.4.0/24,1.2.5.0/23
REMOTE_ALLOW_FROM=

# ===== Optional server hardening (used by setup-remote.sh) =====
# 1 = also write an explicit `AllowUsers <admin> <tunnel>` sshd drop-in
#     (keeps only key access for the admin and the tunnel user).
SSH_ALLOW_USERS=0
# 1 = ensure global sshd hardening (no passwords, no root login) via drop-in.
SSH_HARDEN=1
# 1 = install and enable fail2ban
INSTALL_FAIL2BAN=0
# 1 = enable ufw allowing SSH only
ENABLE_UFW=0
# Source IPs allowed for SSH in ufw (e.g. 1.2.3.4/32). Empty = allow all.
# Defaults to REMOTE_ALLOW_FROM when left empty.
UFW_ALLOW_FROM=
