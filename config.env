# ===== Зарубежный сервер (SSH-доступ для создания туннеля) =====
# IP или hostname твоего сервера
REMOTE_HOST=CHANGE_ME
# SSH-порт сервера
REMOTE_PORT=22
# Пользователь с правами sudo на сервере (нужен ключ ИЛИ пароль для входа)
REMOTE_USER=CHANGE_ME

# ===== Туннель =====
# Отдельный пользователь, создаваемый на сервере только для туннеля
TUNNEL_USER=tunnel
# Локальный адрес и порт SOCKS-прокси
LOCAL_SOCKS_ADDR=127.0.0.1
LOCAL_SOCKS_PORT=1080
# Имя блока в ~/.ssh/config
SSHCONFIG_HOST=tunnel
# Локальный ключ для туннеля
LOCAL_KEY=~/.ssh/tunnel

# ===== Опциональное усиление сервера (установщик на remote) =====
# 1 = поставить и включить fail2ban
INSTALL_FAIL2BAN=0
# 1 = включить ufw с разрешением только SSH
ENABLE_UFW=0
# Откуда разрешать SSH в ufw (например 1.2.3.4/32). Пусто = отовсюду.
UFW_ALLOW_FROM=